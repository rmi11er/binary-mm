#!/bin/sh
# Pre-commit: ruff + fast tests (scan package, safety scan, CLI). ~2s. Full suite: `make check`.
# Install once per clone:  git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)"
uv run ruff check src tests
uv run pytest -q -x tests/scan tests/spotcheck/test_safety.py tests/test_cli.py
